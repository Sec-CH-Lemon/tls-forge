# Build output
/bin/
/dist/
/node/vendor/
# `go build ./cmd/tls-forge` from the root drops the binary here, named after
# the module, right next to the source.
/tls-forge

# Documentation, held back until it is ready to publish. To publish it later,
# delete this line — `git add docs/` on its own will not work while it is
# ignored, and the README's Documentation section needs restoring with it.
/docs/

# Coverage
coverage.out
coverage.html

# Node
node_modules/
npm-debug.log*

# A profile measured from the browser on this machine. Per-machine by
# definition, and everything under profile/data is compiled into the binary, so
# committing one would ship somebody's own browser to everybody.
/profile/data/local/

# Python
# Any name, because a throwaway one gets made and a plain `.venv/` would not
# match it — measured the hard way, by nearly committing one.
.venv*/
__pycache__/
*.egg-info/
.pytest_cache/
.coverage
# Where a platform wheel's binary is staged before the wheel is built. The
# source tree ships no binary; the wheel does.
/python/src/tlsforge/bin/

# Editors and OS
.DS_Store
.idea/
.vscode/
*.swp
