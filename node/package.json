{
  "name": "tls-forge",
  "version": "1.0.0",
  "description": "Scraping HTTP client for Node that gets past TLS fingerprinting \u2014 sends a real browser's JA3/JA4, HTTP/2 and header order",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD-PARTY-NOTICES.txt"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "compile": "node scripts/compile.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test --experimental-test-coverage --test-coverage-lines=100 --test-coverage-functions=100 --test-coverage-branches=100 \"test/*.test.ts\""
  },
  "optionalDependencies": {
    "tls-forge-darwin-arm64": "1.0.0",
    "tls-forge-darwin-x64": "1.0.0",
    "tls-forge-linux-arm64": "1.0.0",
    "tls-forge-linux-x64": "1.0.0",
    "tls-forge-windows-x64": "1.0.0"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "typescript": "5.9.3"
  },
  "keywords": [
    "scraper",
    "scraping",
    "web-scraping",
    "cloudflare",
    "bot-detection",
    "anti-bot",
    "tls",
    "tls-fingerprint",
    "ja3",
    "ja4",
    "http2",
    "fingerprint",
    "browser",
    "impersonate",
    "utls"
  ],
  "author": "Ihar Kazlouski",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sec-CH-Lemon/tls-forge.git",
    "directory": "node"
  }
}
