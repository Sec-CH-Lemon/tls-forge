{
  "name": "tls-forge",
  "version": "0.0.0-dev",
  "description": "HTTP client for Node whose TLS and HTTP/2 fingerprints are a real browser's",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js"
  },
  "files": [
    "index.js",
    "binary.js",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD-PARTY-NOTICES.txt"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node --test --experimental-test-coverage 'test/*.test.js'"
  },
  "optionalDependencies": {
    "@sec-ch-lemon/tls-forge-darwin-arm64": "0.0.0-dev",
    "@sec-ch-lemon/tls-forge-darwin-x64": "0.0.0-dev",
    "@sec-ch-lemon/tls-forge-linux-arm64": "0.0.0-dev",
    "@sec-ch-lemon/tls-forge-linux-x64": "0.0.0-dev",
    "@sec-ch-lemon/tls-forge-win32-x64": "0.0.0-dev"
  },
  "keywords": [
    "tls",
    "ja3",
    "ja4",
    "fingerprint",
    "http2",
    "browser",
    "impersonate",
    "utls"
  ],
  "author": "Ihar Kazlouski",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sec-CH-Lemon/tls-forge.git",
    "directory": "node"
  }
}
